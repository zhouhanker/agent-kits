{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhouhanker.github.io/agent-kits/schemas/profile.schema.json",
  "title": "agent-kits profile",
  "type": "object",
  "required": ["profile"],
  "properties": {
    "profile": {
      "type": "object",
      "required": ["schema_version", "id", "description", "kits"],
      "properties": {
        "schema_version": {"const": 1},
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "description": {"type": "string", "minLength": 1},
        "kits": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
